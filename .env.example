# Supabase — URL e chiavi del progetto (valori reali in .env.local, mai committati)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: SOLO server-side, mai nel browser (bypassa la RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — SOLO server-side (mai NEXT_PUBLIC_*): letti da supabase/config.toml
# via env(...). Lasciare vuoti finché non si configura Google Cloud; Google si
# attiva quando questi valori sono presenti in .env.local.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Connessione Postgres diretta all'istanza locale — SOLO per i test di schema/RLS
# (PostgREST non espone i cataloghi di sistema). Esempio locale:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Nome del brand (pubblico, configurabile) — default "Belora" se assente
NEXT_PUBLIC_BRAND_NAME=

# Anthropic — chiave SOLO server-side (mai NEXT_PUBLIC_*, mai nel bundle client).
# Il modello dell'intervista di onboarding è opzionale: se vuoto vale il default
# "claude-haiku-4-5".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ONBOARDING=

# Stripe (P5 billing) — SOLO server-side, mai nel bundle client. Sono config di DEPLOY
# (env Vercel), non artefatti del codice: il verde dei test usa un fake PaymentProvider
# iniettato, senza chiavi reali. Il webhook verifica la firma con STRIPE_WEBHOOK_SECRET.
# STRIPE_PRICE_PRO è il price id ricorrente del piano Pro. Lasciare vuoti finché non si
# configura Stripe: il billing resta dormiente (getStripePaymentProvider lancia solo se
# invocato senza queste variabili).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Origin pubblico dell'app, per le URL di ritorno di Checkout/Billing Portal (es.
# https://ulaba.net). Pubblico (NEXT_PUBLIC_*): è solo l'URL di redirect, non un segreto.
NEXT_PUBLIC_APP_URL=
